{% comment %} On Paper — grid de swatches (Color / Hotstamping). Params: palette, property (= label),
  default (nombre). Paletas OFICIALES del catálogo ago-2026 (CATALOGO.pdf + CATALOGO_CAJAS.pdf); el
  nombre es el valor que viaja al carrito/pedido — no renombrar sin avisar al taller.
  El hex es un placeholder aproximado; al subir la textura real a Files como `swatch-<slug>.jpg`
  aparece sola encima del color. El mismo slug del color se usa para la imagen de producto por color:
  assets/<handle>-<slug>.jpg (ver op-product.js). {% endcomment %}
{%- liquid
  case palette
    when 'hotstamping'
      assign data = "Cobre|#b5723a|hs-cobre;Dorado|#c9a227|hs-dorado;Rosa Metálico|#b76e79|hs-rosa-metalico;Plateado|#c9c9c9|hs-plateado;Café Matte|#5c4433|hs-cafe-matte;Negro Matte|#2e2e2e|hs-negro-matte;Blanco Matte|#e8e8e8|hs-blanco-matte;Quemado|#d8d2c6|hs-quemado"
    when 'vinipieles'
      assign data = "Blanco|#f5f3ee|vini-blanco;Blanco Hueso|#e9e4da|vini-blanco-hueso;Nude|#c9b49c|vini-nude;Café Claro|#8a6248|vini-cafe-claro;Café|#4a362a|vini-cafe;Vino|#6a1f26|vini-vino;Terracota|#96491f|vini-terracota;Verde Militar|#4c4f3a|vini-verde-militar;Azul Marino|#1f2c44|vini-azul-marino;Negro Matte|#232323|vini-negro-matte;Negro Brillante|#2e2e30|vini-negro-brillante;Taupe|#837c74|vini-taupe;Gris Oscuro|#7c8188|vini-gris-oscuro;Gris Marmoleado|#9fa3a6|vini-gris-marmoleado;Gris Claro|#dddddd|vini-gris-claro;Rosa Metálico|#b07b6e|vini-rosa-metalico;Azul Metálico|#33507a|vini-azul-metalico"
    when 'telas-plastificadas'
      assign data = "Blanco|#f2f1ea|plast-blanco;Gris Claro|#cbc8bf|plast-gris-claro;Gris|#6e7370|plast-gris;Rojo|#a33036|plast-rojo;Azul Oscuro|#1e2438|plast-azul-oscuro;Negro|#26231f|plast-negro"
    when 'papel-texturizado'
      assign data = "Blanco|#fcfcfa|papel-blanco;Marfil Brilloso|#edebe0|papel-marfil-brilloso;Kaki|#d6c98f|papel-kaki;Café Claro|#a97c50|papel-cafe-claro;Café|#6c4429|papel-cafe;Vino Brilloso|#741f31|papel-vino-brilloso;Verde Oscuro Brilloso|#1f4a32|papel-verde-oscuro-brilloso;Verde|#6f9b62|papel-verde;Azul|#3e6c8e|papel-azul;Indigo Brilloso|#2a3f8f|papel-indigo-brilloso;Negro Brilloso|#191919|papel-negro-brilloso;Negro Matte|#3b3b3b|papel-negro-matte;Negro Textura Piel|#33343b|papel-negro-textura-piel;Plomo|#a5adb0|papel-plomo"
    else
      assign data = "Guinda|#6e2230|tela-guinda;Terracota|#a8542f|tela-terracota;Naranja|#c1622a|tela-naranja;Naranja Oscuro|#9c5b2e|tela-naranja-oscuro;Mostaza|#b9912f|tela-mostaza;Verde Oliva|#6b6f3a|tela-verde-oliva;Azul Marino|#2c3a5a|tela-azul-marino;Gris|#b0afa8|tela-gris;Gris Oscuro|#57534e|tela-gris-oscuro;Negro|#1b1b18|tela-negro;Café|#4b3a30|tela-cafe;Café Claro|#a07b50|tela-cafe-claro;Arena|#c9b393|tela-arena;Avena|#e0d3b8|tela-avena;Lino|#e5e0d4|tela-lino;Blanco Crema|#f1ede2|tela-blanco-crema;Blanco Metálico|#edeae4|tela-blanco-metalico;Plata Metálico|#c4c4c0|tela-plata-metalico;Gris Metálico|#4e5457|tela-gris-metalico"
  endcase
  assign rows = data | split: ';'
-%}
<div class="op-product_swatches" data-op-picker data-prop="{{ property | escape }}">
  <input type="hidden" name="properties[{{ property }}]" value="{{ default }}">
  {%- for r in rows -%}
    {%- assign parts = r | split: '|' -%}
    {%- assign nm = parts[0] -%}
    {%- assign hx = parts[1] -%}
    {%- assign fn = 'swatch-' | append: parts[2] | append: '.jpg' -%}
    <button type="button" class="op-product_swatch{% if nm == default %} is-active{% endif %}" data-val="{{ nm | escape }}" title="{{ nm | escape }}" aria-label="{{ nm | escape }}" style="background-color: {{ hx }}; background-image: url({{ fn | file_url }});"></button>
  {%- endfor -%}
</div>
